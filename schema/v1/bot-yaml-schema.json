{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://librebot.dev/schema/bot-source/v1/bot-yaml-schema.json",
  "title": "Librebot bot.yaml (source format v1)",
  "description": "Consolidated bot definition. instructions.md carries the main prompt; knowledge/ and skills/ are file trees; knowledgeSources holds structured external references. Builtin tools are always on and must not be declared; local-execution MCP servers are unsupported.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "name", "description", "modelRoles"],
  "properties": {
    "formatVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "icon": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(\\./)?[^.\\\\/:\\s][^\\\\:\\s]*\\.([sS][vV][gG]|[pP][nN][gG]|[wW][eE][bB][pP])$",
      "description": "Repository-relative path to an SVG, PNG, or WebP bot icon. For PNG and WebP, use a square image, ideally 512 × 512 pixels; transparent backgrounds are supported. For SVG, use a square viewBox. Icons are displayed at small sizes, so prefer simple artwork with adequate padding and avoid fine details or text."
    },
    "modelRoles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "label"],
        "properties": {
          "role": { "enum": ["default", "smol", "slow", "plan"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "requirements": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tools": { "type": "boolean" },
              "vision": { "type": "boolean" },
              "reasoning": { "type": "boolean" },
              "minContextWindow": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "workspace": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "path"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "path": { "type": "string", "pattern": "^\\./([^/.][^/]*)(/[^/.][^/]*)*$|^\\./$" }
        }
      }
    },
    "triggers": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "kind", "eventTypes", "deciderInstructions"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "type": "string", "maxLength": 2000 },
          "kind": { "const": "gitrepo" },
          "eventTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "enum": ["issue.opened", "issue.updated", "issue.closed", "issue.reopened", "issue.comment.created", "issue.comment.updated", "change_request.opened", "change_request.updated", "change_request.closed", "change_request.reopened", "change_request.merged", "change_request.commits_updated", "change_request.comment.created", "change_request.comment.updated", "change_request.approval_changed", "repository.pushed"] }
          },
          "inputs": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "type"],
              "properties": {
                "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
                "label": { "type": "string", "maxLength": 100 },
                "type": { "enum": ["string", "number", "boolean", "select"] },
                "required": { "type": "boolean" },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50,
                  "items": { "type": "string", "minLength": 1, "maxLength": 200 }
                },
                "help": { "type": "string", "maxLength": 500 }
              }
            }
          },
          "deciderRole": { "enum": ["default", "smol", "slow", "plan"] },
          "deciderInstructions": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "enabledByDefault": { "type": "boolean" }
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "kind", "capabilities"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "kind": { "const": "gitrepo" },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "capabilities": {
            "type": "array", "minItems": 1, "maxItems": 11, "uniqueItems": true,
            "items": { "enum": ["read_issue", "push_branch", "propose_change", "comment_issue", "search_issues", "read_change_request", "read_repository", "update_issue_labels", "react_issue", "update_issue_body", "update_issue_title"] }
          }
        }
      }
    },
    "connectors": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "tools"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 1000 },
          "required": { "type": "boolean" },
          "tools": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "label", "tools"],
              "properties": {
                "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "tools": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1, "maxLength": 200 }
                }
              }
            }
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "description": "Remote MCP server identity. The runtime binds only this endpoint; local execution is unsupported."
          }
        }
      }
    },
    "knowledgeSources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "url"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kind": { "enum": ["resource", "repo"] },
          "url": { "type": "string", "format": "uri", "maxLength": 500 },
          "ref": { "type": "string", "maxLength": 256 }
        }
      }
    }
  }
}
